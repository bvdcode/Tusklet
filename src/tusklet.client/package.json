{
  "name": "tusklet.client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc -b && vite build",
    "lint": "eslint . && node scripts/check-viewport-units.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@mui/icons-material": "~9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/stylis-plugin-rtl": "^9.6.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@tanstack/react-query": "^5.104.5",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.3",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "stylis": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
